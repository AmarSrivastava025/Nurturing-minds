{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-scheduled-emails",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/check-scheduled-whatsapp",
      "schedule": "0 1 * * *"
    }
  ]
}
