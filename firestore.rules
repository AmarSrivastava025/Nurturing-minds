rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /patients/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /therapists/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /sessions/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /progressSummaries/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /invoices/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /expenses/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /programs/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /invites/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /notifications/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /dailySlotConfigs/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /clinicSettings/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /emailLogs/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /messageLogs/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
