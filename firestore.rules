rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow access to all documents
    match /{document=**} {
      allow read, write: if true;
    }

    // Dedicated rule for emailLogs collection (automated email events & tracking)
    match /emailLogs/{document=**} {
      allow read, create, write, update: if true;
    }

    // Dedicated rule for messageLogs collection (automated WhatsApp & SMS alerts)
    match /messageLogs/{document=**} {
      allow read, create, write, update: if true;
    }
  }
}
