# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key for sending automated transactional emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# RESEND_FROM_EMAIL: Sender email address (default: connect@drsweetybhatnagar.com)
RESEND_FROM_EMAIL="connect@drsweetybhatnagar.com"

# CRON_SECRET: Shared secret Vercel sends as "Authorization: Bearer <value>" on cron runs.
# Required to protect /api/cron/check-scheduled-emails once you set it.
CRON_SECRET="generate-a-long-random-string"

# RESEND_FEEDBACK_FORM_URL: Public link used in the 1-day feedback email CTA.
# Leave blank to fall back to "reply to this email" instead of a broken link.
RESEND_FEEDBACK_FORM_URL="https://docs.google.com/forms/d/e/REAL_FORM_ID/viewform"

# FIRESTORE_PROJECT_ID: Dedicated Firestore Database Project ID
FIRESTORE_PROJECT_ID="ai-studio-nurturingmindsth-306ae0f0-9613-4944-96ec-a37fdb5bd347"

# TWILIO_ACCOUNT_SID: Twilio Account SID for WhatsApp & SMS dispatches
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# TWILIO_AUTH_TOKEN: Twilio Auth Token for authentication
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# TWILIO_WHATSAPP_NUMBER: Twilio WhatsApp sender (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# TWILIO_PHONE_NUMBER: Twilio SMS sender phone number
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# WHATSAPP_WEBHOOK_URL: Optional external webhook for AiSensy, Wati, Gupshup, or Gallabox
WHATSAPP_WEBHOOK_URL="https://api.example.com/v1/whatsapp/webhook"
